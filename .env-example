# Copy to .env and adjust for your environment:
#   cp .env-example .env

# Local / non-Docker paths (Docker Compose overrides these inside containers)
DATABASE_FILE="./data/learnhub.db"
UPLOADS_DIR="./storage/uploads"
LOGS_DIR="./storage/logs"
AI_MODELS_DIR="./storage/models"

# Required: use a long random value in production
JWT_SECRET="change-this-in-production"
SESSION_COOKIE_NAME="learnhub_session"
# true for HTTPS; false only for plain HTTP on LAN
SESSION_COOKIE_SECURE="false"

# Offline grader
OFFLINE_GRADER_URL="http://localhost:8001"
OFFLINE_GRADER_TIMEOUT_MS="30000"
OFFLINE_AI_ENABLED="true"
AI_GRADING_MODE="sync"
AI_FALLBACK_BEHAVIOR="manual_review"
AI_CONFIDENCE_HIGH="0.90"
AI_CONFIDENCE_MEDIUM="0.70"
GRADER_PROVIDER="auto"

# Ollama
OLLAMA_IMAGE="ollama/ollama:latest"
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_MODEL="gemma2:2b"
# Only list models you have pulled (`ollama list`). Extra names cause 404 retries and slow failures.
OLLAMA_FALLBACK_MODELS=""
OLLAMA_TIMEOUT_MS="240000"
OLLAMA_NUM_PREDICT="2048"
OLLAMA_TUTOR_NUM_PREDICT="1024"
OLLAMA_TEMPERATURE="0.10"

# Optional: URL shown on login / share helpers
LOGIN_SHARE_URL="http://localhost:3000/login"
# LOGIN_SHARE_URLS="http://localhost:3000/login,http://192.168.1.10:3000/login"

# Optional host ports (docker-compose.images.yml)
# LMS_HOST_PORT="3000"
# OFFLINE_GRADER_HOST_PORT="8001"
# OLLAMA_HOST_PORT="11434"

# Optional AI tutor / quiz-gen tuning
# AI_TUTOR_QUESTION_CHAR_LIMIT="1200"
# AI_TUTOR_HISTORY_WINDOW="6"
# AI_TUTOR_HISTORY_CHARS="320"
# AI_TUTOR_LESSON_CHUNK_CHARS="680"
# AI_TUTOR_LESSON_MAX_CHUNKS="4"
# AI_TUTOR_LESSON_MAX_CONTEXT_CHARS="3200"
# AI_QUIZ_GEN_LESSON_CHUNK_CHARS="800"
# AI_QUIZ_GEN_MAX_CHUNKS="5"
# AI_QUIZ_GEN_MAX_CONTEXT_CHARS="4500"

# LEARNHUB_AUTO_SEED="true"
